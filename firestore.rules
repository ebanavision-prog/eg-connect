rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'profileType']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.profileType in ['individual', 'company'];
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      // The directory/home screens list all members for signed-in users; the
      // client already hides profiles with privacyMode == 'private'.
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'name', 'phone', 'birthday', 'profession', 'role', 'city', 'avatar',
                      'profileType', 'updatedAt', 'employees', 'yearsInMarket', 'website', 'privacyMode',
                      'isInvestor', 'investorSectors', 'investorTicketRange', 'investorStage', 'investorBio',
                      'recoveryEmail'
                    ]));
    }

    // Contacts
    match /users/{userId}/contacts/{contactId} {
      allow read, write: if isOwner(userId);
    }

    // Conversations and messages
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt']);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow create: if isSignedIn() &&
                      (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) &&
                      request.resource.data.senderId == request.auth.uid;
      }
    }

    // Companies directory
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid &&
                    !('isVerified' in request.resource.data.diff(resource.data).affectedKeys()) &&
                    !('verificationStatus' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Marketplace posts
    match /marketplace_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Licitaciones: contenido curado, no lo publica cualquier usuario todavía
    // (eso requiere roles de administrador, ver plan de Backlog). Por ahora
    // solo lectura; se añaden documentos manualmente desde la consola de
    // Firebase hasta que exista un panel de admin.
    match /tenders/{tenderId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Eventos locales: cualquier miembro puede publicar uno y marcar asistencia
    // en el de otros. El creador controla el contenido; el resto solo puede
    // tocar `attendeeIds` (asistir/no asistir).
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
                      resource.data.authorId == request.auth.uid ||
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds'])
                    );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Iniciativas y Proyectos: cualquier miembro puede crear una y luego
    // sumarse a las de otros. El creador controla título/descripción; el resto
    // de usuarios solo puede tocar el campo `members` (unirse/salir), nunca el
    // contenido de la iniciativa.
    match /initiatives/{initiativeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && (
                      resource.data.creatorId == request.auth.uid ||
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                    );
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }
  }
}
