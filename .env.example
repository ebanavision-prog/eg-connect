VITE_GEMINI_PROXY_URL=https://ebanavision.com/api/gemini-proxy.php

# Firebase Storage exige plan Blaze — mientras no esté activado, dejar en
# false (o sin poner) para que las fotos de perfil se guarden en base64 al
# instante en vez de intentar una subida condenada a fallar (ver
# uploadAvatarIfNeeded en firebaseService.ts). Cambiar a true solo el día
# que se active Storage de verdad.
VITE_FIREBASE_STORAGE_ENABLED=false

# Opcional — solo habilita el botón "Compartir en Instagram" (Tarjeta Visual
# en InviteScreen.tsx), que usa el deep link instagram-stories://share con
# source_application=<este ID>. Sin este valor, ese botón específico
# simplemente no aparece; el resto de la tarjeta (descargar, copiar enlace,
# compartir nativo, LinkedIn, X, Facebook) funciona igual sin él. Es el
# "Facebook App ID" que Meta pide para el deep link de Stories — se obtiene
# en developers.facebook.com si algún día se quiere registrar la app.
VITE_FACEBOOK_APP_ID=

# Opcional — activa notificaciones push reales (FCM). Sin esto, el botón
# "Permitir Notificaciones" en Ajustes sigue pidiendo el permiso normal del
# navegador (notificaciones locales, solo mientras la pestaña está abierta),
# pero no registra el dispositivo para push real en segundo plano.
# Se genera gratis (FCM nunca ha pedido plan Blaze) en Firebase Console →
# Configuración del proyecto → Cloud Messaging → "Web Push certificates" →
# Generar par de claves.
VITE_FCM_VAPID_KEY=

# Opcional — URL del endpoint PHP que de verdad DISPARA un push (ver
# server/fcm-send.php). Sin este valor, sendPushToUser() en pushService.ts
# se queda sin hacer nada con honestidad (no hay ningún intento de red que
# vaya a fallar). Mismo hosting/patrón que VITE_GEMINI_PROXY_URL — requiere
# además que el servidor tenga server/config.php con FIREBASE_PROJECT_ID y
# FIREBASE_SERVICE_ACCOUNT_PATH apuntando a una cuenta de servicio real
# (Firebase Console → Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada).
VITE_FCM_SEND_URL=https://ebanavision.com/api/fcm-send.php
