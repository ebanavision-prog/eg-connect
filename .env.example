VITE_GEMINI_PROXY_URL=https://ebanavision.com/api/gemini-proxy.php

# Firebase Storage exige plan Blaze — mientras no esté activado, dejar en
# false (o sin poner) para que las fotos de perfil se guarden en base64 al
# instante en vez de intentar una subida condenada a fallar (ver
# uploadAvatarIfNeeded en firebaseService.ts). Cambiar a true solo el día
# que se active Storage de verdad.
VITE_FIREBASE_STORAGE_ENABLED=false

# Opcional — solo habilita el botón "Compartir en Instagram" (Tarjeta Visual
# en InviteScreen.tsx), que usa el deep link instagram-stories://share con
# source_application=<este ID>. Sin este valor, ese botón específico
# simplemente no aparece; el resto de la tarjeta (descargar, copiar enlace,
# compartir nativo, LinkedIn, X, Facebook) funciona igual sin él. Es el
# "Facebook App ID" que Meta pide para el deep link de Stories — se obtiene
# en developers.facebook.com si algún día se quiere registrar la app.
VITE_FACEBOOK_APP_ID=
