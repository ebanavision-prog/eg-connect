VITE_GEMINI_PROXY_URL=https://ebanavision.com/api/gemini-proxy.php

# Firebase Storage exige plan Blaze — mientras no esté activado, dejar en
# false (o sin poner) para que las fotos de perfil se guarden en base64 al
# instante en vez de intentar una subida condenada a fallar (ver
# uploadAvatarIfNeeded en firebaseService.ts). Cambiar a true solo el día
# que se active Storage de verdad.
VITE_FIREBASE_STORAGE_ENABLED=false
