{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eg-connect-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host=0.0.0.0"],
      "port": 3010,
      "autoPort": true
    },
    {
      "name": "eg-connect-emulator",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "VITE_USE_FIREBASE_EMULATOR=true npx vite --host=0.0.0.0 --port=$PORT"],
      "port": 3035,
      "autoPort": true
    }
  ]
}
